rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kullanıcı yalnızca kendi profilini ve izin verilen verilerini okuyabilir/yazabilir
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Abonelik seviyesi ve kullanım kotaları yalnızca sunucu (Admin SDK) tarafından yazılabilir
      allow write: if request.auth != null && request.auth.uid == userId &&
                      !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['subscription_tier', 'subscription_status', 'daily_usage', 'messages_max', 'images_max']);
      
      // Kullanıcının özel sohbet geçmişi
      match /history/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Kullanıcının özel hafıza profili
      match /profile/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Duo / Aile Üyeliği Paylaşımlı Kayıtları
    match /families/{familyId} {
      allow read: if request.auth != null && (
        resource.data.owner_uid == request.auth.uid || 
        request.auth.token.email in resource.data.members
      );
      allow write: if request.auth != null && resource.data.owner_uid == request.auth.uid;
    }
    
    // Sistem abonelik paketleri herkes tarafından okunabilir, kimse tarafından yazılamaz
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Varsayılan kural: Diğer tüm erişimleri engelle
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
